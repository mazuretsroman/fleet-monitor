
# API
NODE_ENV=development
API_PORT=3000

# Web (Vite dev server)
VITE_API_URL=http://localhost:3000

# PostgreSQL (used by the db container)
POSTGRES_USER=robotsmoving
POSTGRES_PASSWORD=robotsmoving
POSTGRES_DB=robotsmoving
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Connections
DATABASE_URL=postgres://robotsmoving:robotsmoving@localhost:5432/robotsmoving
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
