{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node --watch --env-file=../.env src/server.js",
    "start": "node src/server.js",
    "migrate:up": "node --env-file-if-exists=../.env scripts/migrate.js up",
    "migrate:down": "node --env-file-if-exists=../.env scripts/migrate.js down",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js"
  },
  "license": "ISC",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
